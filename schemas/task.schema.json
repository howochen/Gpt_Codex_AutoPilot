{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BieLuanZha Dev AutoPilot Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "task_id", "revision", "repo", "base_commit", "title", "objective", "allowed_paths", "acceptance", "approval_required"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{3,64}$"},
    "revision": {"type": "integer", "minimum": 1},
    "repo": {"const": "howochen/BieLuanZha"},
    "base_commit": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 160},
    "objective": {"type": "string", "minLength": 10, "maxLength": 4000},
    "allowed_paths": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "forbidden_actions": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 200}},
    "acceptance": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string", "maxLength": 400}},
    "approval_required": {"type": "boolean"},
    "spec_paths": {"type": "array", "maxItems": 5, "items": {"type": "string"}}
  }
}
